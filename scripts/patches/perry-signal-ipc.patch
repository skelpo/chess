@@ -0,0 +1,149 @@
+//! Keep IPC for process listeners unless a direct call names a known non-IPC
+//! event. Namespace escapes, dynamic events, and extracted methods remain
+//! conservative. OS signal support is selected independently.
+
+use perry_hir::{Expr, Module, Stmt};
+
+fn listener(name: &str) -> bool {
+    matches!(
+        name,
+        "on" | "once" | "addListener" | "prependListener" | "prependOnceListener"
+    )
+}
+
+fn direct_listener(expr: &Expr) -> bool {
+    matches!(expr, Expr::PropertyGet { object, property, .. }
+        if matches!(object.as_ref(), Expr::GlobalGet(0)) && listener(property))
+}
+
+fn lexical_callback(expr: &Expr) -> bool {
+    match expr {
+        Expr::Closure { is_arrow: true, .. } => true,
+        // The assignment preserves the callback identity for removeListener.
+        Expr::LocalSet(_, value) => lexical_callback(value),
+        _ => false,
+    }
+}
+
+fn known_non_ipc_args(args: &[Expr]) -> bool {
+    args.get(1).is_some_and(lexical_callback)
+        && matches!(args.first(), Some(Expr::String(event))
+            if matches!(event.as_str(), "SIGINT" | "SIGTERM" | "exit" | "beforeExit"))
+}
+
+fn expr_may_receive_ipc(expr: &Expr) -> bool {
+    if direct_listener(expr)
+        || matches!(expr, Expr::NativeMethodCall { module, method, .. }
+            if module.trim_start_matches("node:") == "process" && listener(method))
+    {
+        return true;
+    }
+    if let Expr::Closure { body, .. } = expr {
+        if stmts_may_receive_ipc(body, &mut expr_may_receive_ipc) {
+            return true;
+        }
+    }
+    let mut found = false;
+    perry_hir::walker::walk_expr_children(expr, &mut |child| {
+        found = found || expr_may_receive_ipc(child);
+    });
+    found
+}
+
+pub(super) fn module_listeners_may_receive_ipc(module: &Module) -> bool {
+    super::module_any_expr_with_stmts(module, &mut expr_may_receive_ipc, stmts_may_receive_ipc)
+}
+
+fn stmts_may_receive_ipc(stmts: &[Stmt], found: &mut dyn FnMut(&Expr) -> bool) -> bool {
+    stmts.iter().any(|stmt| stmt_may_receive_ipc(stmt, found))
+}
+
+// Statement context matters here; keep the match exhaustive like the shared
+// HIR walker, so future statement kinds cannot silently bypass IPC detection.
+fn stmt_may_receive_ipc(stmt: &Stmt, predicate: &mut dyn FnMut(&Expr) -> bool) -> bool {
+    match stmt {
+        Stmt::Let { init, .. } | Stmt::Return(init) => init.as_ref().is_some_and(&mut *predicate),
+        Stmt::Expr(Expr::Call { callee, args, .. })
+            if direct_listener(callee) && known_non_ipc_args(args) =>
+        {
+            // Only a discarded result is safe: process.on returns process,
+            // so a chained call or escaped return value can still receive IPC.
+            // Callbacks/arguments are always visited for nested IPC listeners.
+            // Ordinary functions receive `process` as their `this`; unknown
+            // callbacks could use that receiver to access IPC too.
+            args.iter().any(&mut *predicate)
+        }
+        Stmt::Expr(Expr::NativeMethodCall {
+            module,
+            method,
+            args,
+            object: None,
+            ..
+        }) if module.trim_start_matches("node:") == "process"
+            && listener(method)
+            && known_non_ipc_args(args) =>
+        {
+            args.iter().any(&mut *predicate)
+        }
+        Stmt::Expr(expr) | Stmt::Throw(expr) => predicate(expr),
+        Stmt::If {
+            condition,
+            then_branch,
+            else_branch,
+        } => {
+            predicate(condition)
+                || then_branch
+                    .iter()
+                    .any(|s| stmt_may_receive_ipc(s, predicate))
+                || else_branch
+                    .as_ref()
+                    .is_some_and(|body| body.iter().any(|s| stmt_may_receive_ipc(s, predicate)))
+        }
+        Stmt::While { condition, body } | Stmt::DoWhile { condition, body } => {
+            predicate(condition) || body.iter().any(|s| stmt_may_receive_ipc(s, predicate))
+        }
+        Stmt::For {
+            init,
+            condition,
+            update,
+            body,
+        } => {
+            init.as_ref()
+                .is_some_and(|s| stmt_may_receive_ipc(s, predicate))
+                || condition.as_ref().is_some_and(&mut *predicate)
+                || update.as_ref().is_some_and(&mut *predicate)
+                || body.iter().any(|s| stmt_may_receive_ipc(s, predicate))
+        }
+        Stmt::Labeled { body, .. } => stmt_may_receive_ipc(body, predicate),
+        Stmt::Try {
+            body,
+            catch,
+            finally,
+        } => {
+            body.iter().any(|s| stmt_may_receive_ipc(s, predicate))
+                || catch
+                    .as_ref()
+                    .is_some_and(|c| c.body.iter().any(|s| stmt_may_receive_ipc(s, predicate)))
+                || finally
+                    .as_ref()
+                    .is_some_and(|body| body.iter().any(|s| stmt_may_receive_ipc(s, predicate)))
+        }
+        Stmt::Switch {
+            discriminant,
+            cases,
+        } => {
+            predicate(discriminant)
+                || cases.iter().any(|c| {
+                    c.test.as_ref().is_some_and(&mut *predicate)
+                        || c.body.iter().any(|s| stmt_may_receive_ipc(s, predicate))
+                })
+        }
+        Stmt::Break
+        | Stmt::Continue
+        | Stmt::LabeledBreak(_)
+        | Stmt::LabeledContinue(_)
+        | Stmt::PreallocateBoxes(_)
+        | Stmt::PreallocateTdzBoxes(_)
+        | Stmt::ReleaseBoxes(_) => false,
+    }
+}
